{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "web/**",
        "models/**",
        "core/**",
        "synthetic_data.py"
      ],
      "maxDuration": 30
    }
  }
}
