# Vercel Deployment Exclusions
# Keep deployment bundle lightweight (<50MB zipped / <250MB uncompressed)

# Heavy training datasets
data/
data/**

# Scratch and intermediate logs
scratch/
scratch/**
*.log
*.tmp

# Version control and editor files
.git/
.gitignore
.vscode/
.idea/

# Python byte-code and virtual environments
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/

# Training scripts and non-web assets
train_currency_model.py
*.docx
*.pdf
uploaded_fake_note.jpg
